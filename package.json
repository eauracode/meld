{
  "name": "meld",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build:functions": "node scripts/bundle-edge-functions.mjs",
    "build:api-kits": "node scripts/bundle-api-kits.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/generated.ts",
    "db:start": "supabase start",
    "db:migrate": "supabase db reset"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "supabase": "^2.110.0",
    "turbo": "^2.5.0"
  }
}
