// MELD — Prisma schema (Render Postgres)
// Ported from docs/07_DATABASE_SCHEMA.sql. The data model is unchanged from
// the original design; what changed is auth (a self-contained User model
// with a password hash, replacing Supabase's auth.users) and access control
// (NestJS guards/services instead of Postgres RLS — see
// 01_SHARED_FOUNDATIONS.md's 2026-07-30 architecture update).
// Money is BIGINT kobo (₦1 = 100 kobo). Never floats. IDs are UUID.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------
enum UserRole {
  merchant
  rider
  ops_agent
  ops_admin

  @@map("user_role")
}

enum MerchantStatus {
  pending_approval
  approved
  suspended

  @@map("merchant_status")
}

enum RiderStatus {
  applied
  approved
  rejected
  active
  suspended

  @@map("rider_status")
}

enum VehicleType {
  bike
  car
  van

  @@map("vehicle_type")
}

enum FeeBorneBy {
  customer
  merchant

  @@map("fee_borne_by")
}

enum PaymentType {
  prepaid
  cod

  @@map("payment_type")
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed

  @@map("payment_status")
}

enum OrderStatus {
  created
  awaiting_assignment
  assigned
  out_for_delivery
  delivered
  failed
  returned
  cancelled

  @@map("order_status")
}

enum DeliveryStatus {
  assigned
  accepted
  en_route
  arrived
  delivered
  failed

  @@map("delivery_status")
}

enum WithdrawalStatus {
  requested
  processing
  paid
  failed

  @@map("withdrawal_status")
}

enum RemittanceStatus {
  pending
  remitted
  reconciled
  flagged

  @@map("remittance_status")
}

enum LedgerAccountType {
  merchant_payable
  rider_wallet
  meld_revenue
  cash_in_transit
  partner_float
  suspense

  @@map("ledger_account_type")
}

enum FeeRuleScope {
  global
  merchant

  @@map("fee_rule_scope")
}

enum FeeRuleType {
  flat
  by_state

  @@map("fee_rule_type")
}

enum NotificationChannel {
  sms
  email
  in_app

  @@map("notification_channel")
}

// -----------------------------------------------------------------------
// USERS  (replaces Supabase auth.users + profiles)
// -----------------------------------------------------------------------
model User {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole
  fullName     String   @map("full_name")
  phone        String?
  email        String?  @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  merchant Merchant?
  rider    Rider?

  approvedMerchants     Merchant[]        @relation("MerchantApprovedBy")
  reviewedApplications  RiderApplication[] @relation("ApplicationReviewedBy")
  createdOrders         Order[]           @relation("OrderCreatedBy")
  assignedDeliveries     Delivery[]        @relation("DeliveryAssignedBy")
  createdStockMovements  StockMovement[]   @relation("StockMovementCreatedBy")
  createdFeeRules        FeeRule[]         @relation("FeeRuleCreatedBy")
  reconciledRemittances  CashRemittance[]  @relation("RemittanceReconciledBy")
  createdLedgerTx        LedgerTransaction[] @relation("LedgerTxCreatedBy")
  notifications          Notification[]
  auditEntries           AuditLog[]

  @@map("users")
}

// -----------------------------------------------------------------------
// MERCHANTS
// -----------------------------------------------------------------------
model Merchant {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessName    String         @map("business_name")
  contactPerson   String?        @map("contact_person")
  phone           String?
  email           String?
  pickupAddress   String?        @map("pickup_address")
  pickupState     String?        @map("pickup_state")
  bankName        String?        @map("bank_name")
  bankCode        String?        @map("bank_code")
  bankAccountNo   String?        @map("bank_account_no")
  bankAccountName String?        @map("bank_account_name")
  status          MerchantStatus @default(pending_approval)
  feeBorneBy      FeeBorneBy     @default(merchant) @map("fee_borne_by")
  approvedById    String?        @map("approved_by") @db.Uuid
  approvedBy      User?          @relation("MerchantApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?      @map("approved_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  products Product[]
  orders   Order[]
  feeRules FeeRule[]
  // The merchant_payable ledger account is looked up by (type='merchant_payable',
  // ownerType='merchant', ownerId=this.id) — see the LedgerAccount model comment.

  @@index([status])
  @@map("merchants")
}

// -----------------------------------------------------------------------
// RIDER APPLICATIONS  (pre-account)
// -----------------------------------------------------------------------
model RiderApplication {
  id           String      @id @default(uuid()) @db.Uuid
  fullName     String      @map("full_name")
  phone        String
  city         String?
  state        String?
  vehicle      VehicleType
  hasLicence   Boolean     @default(false) @map("has_licence")
  status       RiderStatus @default(applied)
  reviewedById String?     @map("reviewed_by") @db.Uuid
  reviewedBy   User?       @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?   @map("reviewed_at")
  rejectReason String?     @map("reject_reason")
  createdAt    DateTime    @default(now()) @map("created_at")

  rider Rider?

  @@index([status])
  @@map("rider_applications")
}

// -----------------------------------------------------------------------
// RIDERS
// -----------------------------------------------------------------------
model Rider {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @unique @map("user_id") @db.Uuid
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  applicationId   String?           @unique @map("application_id") @db.Uuid
  application     RiderApplication? @relation(fields: [applicationId], references: [id])
  vehicle         VehicleType
  city            String?
  state           String?
  hasLicence      Boolean           @default(false) @map("has_licence")
  bankName        String?           @map("bank_name")
  bankCode        String?           @map("bank_code")
  bankAccountNo   String?           @map("bank_account_no")
  bankAccountName String?           @map("bank_account_name")
  status          RiderStatus       @default(active)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  deliveries      Delivery[]
  cashRemittances CashRemittance[]
  // rider_wallet / cash_in_transit ledger accounts are looked up by
  // (type, ownerType='rider', ownerId=this.id) — see LedgerAccount's comment.

  @@index([status])
  @@map("riders")
}

// -----------------------------------------------------------------------
// WAREHOUSES
// -----------------------------------------------------------------------
model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  state     String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  inventory      Inventory[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

// -----------------------------------------------------------------------
// PRODUCTS & INVENTORY
// -----------------------------------------------------------------------
model Product {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  sku          String?
  name         String
  description  String?
  unit         String   @default("unit")
  reorderLevel Int      @default(0) @map("reorder_level")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  inventory      Inventory[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@unique([merchantId, sku])
  @@index([merchantId])
  @@map("products")
}

model Inventory {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Int       @default(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@index([productId])
  @@map("inventory")
}

model StockMovement {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  change      Int
  reason      String
  refType     String?   @map("ref_type")
  refId       String?   @map("ref_id") @db.Uuid
  createdById String?   @map("created_by") @db.Uuid
  createdBy   User?     @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([productId])
  @@map("stock_movements")
}

// -----------------------------------------------------------------------
// FEE RULES
// -----------------------------------------------------------------------
model FeeRule {
  id                String       @id @default(uuid()) @db.Uuid
  scope             FeeRuleScope
  merchantId        String?      @map("merchant_id") @db.Uuid
  merchant          Merchant?    @relation(fields: [merchantId], references: [id])
  type              FeeRuleType
  intrastateFeeKobo BigInt?      @map("intrastate_fee_kobo")
  byState           Json?        @map("by_state")
  fallbackFeeKobo   BigInt       @default(0) @map("fallback_fee_kobo")
  effectiveFrom     DateTime     @default(now()) @map("effective_from")
  effectiveTo       DateTime?    @map("effective_to")
  createdById       String?      @map("created_by") @db.Uuid
  createdBy         User?        @relation("FeeRuleCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([scope, merchantId])
  @@map("fee_rules")
}

// -----------------------------------------------------------------------
// ORDERS & ITEMS
// -----------------------------------------------------------------------
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  merchantId      String      @map("merchant_id") @db.Uuid
  merchant        Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  externalRef     String?     @map("external_ref")
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  deliveryAddress String      @map("delivery_address")
  deliveryState   String      @map("delivery_state")
  deliveryArea    String?     @map("delivery_area")
  orderValueKobo  BigInt      @map("order_value_kobo")
  paymentType     PaymentType @map("payment_type")
  deliveryFeeKobo BigInt      @default(0) @map("delivery_fee_kobo")
  feeBorneBy      FeeBorneBy  @map("fee_borne_by")
  status          OrderStatus @default(created)
  createdById     String?     @map("created_by") @db.Uuid
  createdBy       User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  items    OrderItem[]
  delivery Delivery?

  @@index([merchantId])
  @@index([status])
  @@index([deliveryState])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?  @map("product_id") @db.Uuid
  product       Product? @relation(fields: [productId], references: [id])
  nameSnapshot  String   @map("name_snapshot")
  quantity      Int
  unitPriceKobo BigInt   @default(0) @map("unit_price_kobo")

  @@index([orderId])
  @@map("order_items")
}

// -----------------------------------------------------------------------
// DELIVERIES  (one per order in v1)
// -----------------------------------------------------------------------
model Delivery {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @unique @map("order_id") @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  riderId        String?        @map("rider_id") @db.Uuid
  rider          Rider?         @relation(fields: [riderId], references: [id])
  status         DeliveryStatus @default(assigned)
  paymentStatus  PaymentStatus  @default(unpaid) @map("payment_status")
  cashCollected  Boolean        @default(false) @map("cash_collected")
  cashAmountKobo BigInt?        @map("cash_amount_kobo")
  assignedById   String?        @map("assigned_by") @db.Uuid
  assignedBy     User?          @relation("DeliveryAssignedBy", fields: [assignedById], references: [id])
  assignedAt     DateTime?      @map("assigned_at")
  completedAt    DateTime?      @map("completed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  virtualAccounts VirtualAccount[]
  payments        Payment[]
  cashRemittance  CashRemittance?

  @@index([riderId])
  @@index([status])
  @@index([paymentStatus])
  @@map("deliveries")
}

// -----------------------------------------------------------------------
// VIRTUAL ACCOUNTS
// -----------------------------------------------------------------------
model VirtualAccount {
  id            String          @id @default(uuid()) @db.Uuid
  purpose       String
  deliveryId    String?         @map("delivery_id") @db.Uuid
  delivery      Delivery?       @relation(fields: [deliveryId], references: [id])
  remittanceId  String?         @unique @map("remittance_id") @db.Uuid
  remittance    CashRemittance? @relation(fields: [remittanceId], references: [id])
  provider      String
  accountNo     String          @map("account_no")
  bankName      String?         @map("bank_name")
  amountKobo    BigInt?         @map("amount_kobo")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([deliveryId])
  @@map("virtual_accounts")
}

// -----------------------------------------------------------------------
// PAYMENTS  (confirmed inflows)
// -----------------------------------------------------------------------
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  deliveryId  String?       @map("delivery_id") @db.Uuid
  delivery    Delivery?     @relation(fields: [deliveryId], references: [id])
  provider    String
  providerRef String        @map("provider_ref")
  amountKobo  BigInt        @map("amount_kobo")
  method      String
  status      PaymentStatus @default(paid)
  raw         Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([provider, providerRef])
  @@map("payments")
}

// -----------------------------------------------------------------------
// CASH REMITTANCES  (COD)
// -----------------------------------------------------------------------
model CashRemittance {
  id                  String            @id @default(uuid()) @db.Uuid
  riderId             String            @map("rider_id") @db.Uuid
  rider               Rider             @relation(fields: [riderId], references: [id], onDelete: Restrict)
  deliveryId          String            @unique @map("delivery_id") @db.Uuid
  delivery            Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  amountOwedKobo      BigInt            @map("amount_owed_kobo")
  amountRemittedKobo  BigInt            @default(0) @map("amount_remitted_kobo")
  status              RemittanceStatus  @default(pending)
  virtualAccount      VirtualAccount?
  reconciledById       String?          @map("reconciled_by") @db.Uuid
  reconciledBy         User?            @relation("RemittanceReconciledBy", fields: [reconciledById], references: [id])
  reconciledAt         DateTime?        @map("reconciled_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  @@index([riderId, status])
  @@map("cash_remittances")
}

// -----------------------------------------------------------------------
// LEDGER  (double-entry — the money core)
// -----------------------------------------------------------------------
model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  type      LedgerAccountType
  ownerType String?           @map("owner_type")
  ownerId   String?           @map("owner_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  entries LedgerEntry[]

  // owner_id is deliberately NOT a Prisma relation: it's polymorphic (points
  // at merchants.id, riders.id, or is null for MELD-owned accounts
  // depending on owner_type), so it can't be a single-table foreign key —
  // same reasoning as the original 07_DATABASE_SCHEMA.sql, which also
  // leaves it unconstrained. PrismaLedgerStore queries by
  // (type, ownerType, ownerId) directly rather than via relation traversal.

  @@unique([type, ownerType, ownerId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  sourceType  String   @map("source_type")
  sourceId    String?  @map("source_id") @db.Uuid
  memo        String?
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("LedgerTxCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String            @map("account_id") @db.Uuid
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  debitKobo     BigInt            @default(0) @map("debit_kobo")
  creditKobo    BigInt            @default(0) @map("credit_kobo")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

// -----------------------------------------------------------------------
// WITHDRAWALS  (merchant settlements & rider payouts)
// -----------------------------------------------------------------------
model Withdrawal {
  id             String           @id @default(uuid()) @db.Uuid
  ownerType      String           @map("owner_type")
  ownerId        String           @map("owner_id") @db.Uuid
  amountKobo     BigInt           @map("amount_kobo")
  status         WithdrawalStatus @default(requested)
  provider       String?
  providerRef    String?          @map("provider_ref")
  bankAccountNo  String?          @map("bank_account_no")
  bankName       String?          @map("bank_name")
  failureReason  String?          @map("failure_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  processedAt    DateTime?        @map("processed_at")

  @@index([ownerType, ownerId, status])
  @@map("withdrawals")
}

// -----------------------------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------------------------
model Notification {
  id              String                @id @default(uuid()) @db.Uuid
  recipientId     String?               @map("recipient_id") @db.Uuid
  recipient       User?                 @relation(fields: [recipientId], references: [id])
  recipientPhone  String?               @map("recipient_phone")
  event           String
  title           String?
  body            String?
  channels        NotificationChannel[] @default([in_app])
  readAt          DateTime?             @map("read_at")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([recipientId, readAt])
  @@map("notifications")
}

// -----------------------------------------------------------------------
// WEBHOOK IDEMPOTENCY
// -----------------------------------------------------------------------
model ProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@map("processed_events")
}

// -----------------------------------------------------------------------
// DEMO REQUESTS  (marketing)
// -----------------------------------------------------------------------
model DemoRequest {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  businessName String?  @map("business_name")
  email        String
  phone        String?
  message      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("demo_requests")
}

// -----------------------------------------------------------------------
// AUDIT LOG
// -----------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}
