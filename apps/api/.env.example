# apps/api — copy to .env for local dev, or set these in Render's dashboard.

# Render Postgres connection string (Settings -> Connect, "Internal" URL when
# the API also runs on Render, "External" URL for local dev / migrations).
DATABASE_URL=

# Long random string — `openssl rand -base64 48` or similar. Rotating this
# invalidates every issued token.
JWT_SECRET=

PORT=3090

# --- Payment partner (packages/payments) — optional, falls back to mock ----
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
PAYSTACK_PREFERRED_BANK=wema-bank
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Notifications (packages/notifications) — optional, falls back to mock -
TERMII_API_KEY=
TERMII_SENDER_ID=MELD
RESEND_API_KEY=
RESEND_FROM_EMAIL="MELD <notifications@meld.africa>"
