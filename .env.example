# MELD — environment variables (Phase 6)
#
# Backend is apps/api (NestJS + Prisma + Postgres, all on Render) — see
# apps/api/.env.example for that app's specific vars (DATABASE_URL,
# JWT_SECRET, payment/notification keys). This file covers what the four
# Next.js frontends need.
#
# Every payment/notification key is optional in dev: everything falls back
# to its mock (see packages/payments/src/factory.ts,
# packages/notifications/src/factory.ts) when unset.

# --- All four Next.js apps ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3090

# --- Marketing site (apps/marketing/src/config/site.ts) ----------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3080
NEXT_PUBLIC_MERCHANT_APP_SIGNUP_URL=http://localhost:3060/signup
NEXT_PUBLIC_MERCHANT_APP_SIGNIN_URL=http://localhost:3060
# Leave unset in v1 — riders apply via the marketing site's own /riders form
# until the rider app has public sign-up (02_PRD_Marketing FR-5).
NEXT_PUBLIC_RIDER_APP_URL=
# Leave unset to show the /demo fallback contact form instead of a Calendly embed.
NEXT_PUBLIC_DEMO_BOOKING_URL=
